# Laravel backend production environment template (only needed if the repo ships backend/).
# Copy into backend/.env on the VPS and fill secrets there. NEVER commit real values.

APP_NAME="Sadat Upgrade"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://SadaatUpgrade.com
FRONTEND_URL=https://SadaatUpgrade.com
ADMIN_URL=https://SadaatUpgrade.com/admin

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sadatupgrade
DB_USERNAME=sadatupgrade
DB_PASSWORD=

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

MAIL_MAILER=log

CORS_ALLOWED_ORIGINS=https://SadaatUpgrade.com,https://www.SadaatUpgrade.com