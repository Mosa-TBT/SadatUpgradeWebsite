# Production environment template for the Next.js frontend.
# Copy to /var/www/sadat-upgrade/shared/.env on the VPS and fill secrets there.
# NEVER commit real values to Git.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://SadaatUpgrade.com
NEXT_PUBLIC_API_URL=https://SadaatUpgrade.com/api

# Non-public runtime secrets (server components) go here and are read at runtime:
# NEXT_PRIVATE_ANALYTICS_KEY=
NEXT_TELEMETRY_DISABLED=1

# --- Email delivery (contact form + live chat notifications) ---
# App Password comes from the account owner (Google App Passwords); keep it
# ONLY in this server-side file (0600, deploy-owned). NEVER commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=baregzay123@gmail.com
SMTP_PASSWORD=
# Recipient mailbox for contact + chat messages:
CONTACT_RECIPIENT=baregzay123@gmail.com
# Optional explicit sender (defaults to SMTP_USER):
# CONTACT_FROM=

# --- Live chat persistent store (server-side, deploy-owned) ---
CHAT_STORE_DIR=/var/www/sadat-upgrade/shared/chat-store