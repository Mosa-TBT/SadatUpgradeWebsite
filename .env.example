# ── Sadaat Upgrade — Next.js frontend environment ────────────────────────────
# Copy this file to `.env.local` and fill in your real values. NEVER commit
# real secrets. Public defaults are used when a variable is absent.

# Public Laravel API base URL consumed by the frontend (also used by the admin panel).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# ── Email delivery (contact form + live chat notifications) ──────────────────
# When SMTP_* are unset, email is DISABLED. The contact form still persists
# every submission to the backend inbox (contact_messages), so the Admin Panel
# keeps working offline of email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Verified sender + recipient for outbound contact/chat mail.
CONTACT_FROM=
CONTACT_RECIPIENT=

# ── Live Chat persistence ────────────────────────────────────────────────────
# Directory for chat JSON files; falls back to in-memory if not writable.
# Default: ./.chat-store
CHAT_STORE_DIR=